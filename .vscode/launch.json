    // "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Sys On PlaydateSimulator",
            "type": "cppvsdbg",
            "request": "launch",
            "cwd": "${workspaceFolder}/demos/sys",
            "program": "${env:PLAYDATE_SDK_PATH}/bin/PlaydateSimulator.exe",
            "args": [
                "${workspaceFolder}/demos/sys/target/sys.pdx"
            ],
            "symbolSearchPath": "${workspaceFolder}/demos/sys/target/debug",
            "stopAtEntry": false,
        }
    ]
}