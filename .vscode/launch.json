    "configurations": [
        {
            "name": "Debug Ex Sys On PlaydateSimulator",
            "type": "cppvsdbg",
            "request": "launch",
            "cwd": "${workspaceFolder}\\examples\\sys",
            "program": "${env:PLAYDATE_SDK_PATH}\\bin\\PlaydateSimulator.exe",
            "args": [
                "${cwd}\\examples\\sys\\target\\sys.pdx"
            ],
            "symbolSearchPath": "${cwd}\\examples\\sys\\target\\debug",
            "stopAtEntry": false
        }
    ]
}